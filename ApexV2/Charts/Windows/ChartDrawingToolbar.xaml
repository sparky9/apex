<UserControl x:Class="ApexV2.Charts.Windows.ChartDrawingToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="50" d:DesignWidth="800"
             Background="{DynamicResource ToolbarBackground}">
    
    <UserControl.Resources>
        <!-- Toolbar Button Style -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="ToolTipService.ShowDuration" Value="10000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Content="{TemplateBinding Content}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PressedBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Active Toolbar Button Style -->
        <Style x:Key="ActiveToolbarButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
        <!-- Separator Style -->
        <Style x:Key="ToolbarSeparator" TargetType="Rectangle">
            <Setter Property="Fill" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="4,8"/>
        </Style>
    </UserControl.Resources>
    
    <DockPanel LastChildFill="False">
        <!-- Selection Tools -->
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
            <Button x:Name="SelectButton" 
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="Select Tool (S)"
                    Click="SelectButton_Click">
                <Path Data="M 2,2 L 2,14 L 6,10 L 10,14 L 14,10 L 10,6 L 14,2 Z" 
                      Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                      Stretch="Uniform"
                      Width="16" Height="16"/>
            </Button>
        </StackPanel>
        
        <Rectangle Style="{StaticResource ToolbarSeparator}"/>
        
        <!-- Line Tools -->
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
            <Button x:Name="TrendLineButton" 
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="Trend Line (L)"
                    Click="TrendLineButton_Click">
                <Path Data="M 2,14 L 14,2" 
                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                      StrokeThickness="2"
                      Stretch="Uniform"
                      Width="16" Height="16"/>
            </Button>
            
            <Button x:Name="HorizontalLineButton" 
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="Horizontal Line (H)"
                    Click="HorizontalLineButton_Click">
                <Path Data="M 2,8 L 14,8" 
                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                      StrokeThickness="2"
                      Stretch="Uniform"
                      Width="16" Height="16"/>
            </Button>
            
            <Button x:Name="VerticalLineButton" 
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="Vertical Line (V)"
                    Click="VerticalLineButton_Click">
                <Path Data="M 8,2 L 8,14" 
                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                      StrokeThickness="2"
                      Stretch="Uniform"
                      Width="16" Height="16"/>
            </Button>
        </StackPanel>
        
        <Rectangle Style="{StaticResource ToolbarSeparator}"/>
        
        <!-- Shape Tools -->
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
            <Button x:Name="RectangleButton" 
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="Rectangle (R)"
                    Click="RectangleButton_Click">
                <Rectangle Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                          StrokeThickness="2"
                          Width="12" Height="8"/>
            </Button>
            
            <Button x:Name="PriceChannelButton" 
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="Price Channel"
                    Click="PriceChannelButton_Click">
                <Grid Width="16" Height="16">
                    <Path Data="M 2,4 L 14,2" 
                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                          StrokeThickness="1.5"/>
                    <Path Data="M 2,12 L 14,10" 
                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                          StrokeThickness="1.5"/>
                </Grid>
            </Button>
            
            <Button x:Name="TimeRangeButton" 
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="Time Range"
                    Click="TimeRangeButton_Click">
                <Grid Width="16" Height="16">
                    <Rectangle Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.5"
                              Fill="Transparent"
                              Width="12" Height="8"/>
                    <Path Data="M 6,2 L 6,14" 
                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                          StrokeThickness="1.5"
                          StrokeDashArray="2,2"/>
                </Grid>
            </Button>
        </StackPanel>
        
        <Rectangle Style="{StaticResource ToolbarSeparator}"/>
        
        <!-- Annotation Tools -->
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
            <Button x:Name="TextAnnotationButton" 
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="Text Annotation (T)"
                    Click="TextAnnotationButton_Click">
                <TextBlock Text="A" 
                          FontWeight="Bold" 
                          FontSize="12"
                          Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
            </Button>
        </StackPanel>
        
        <Rectangle Style="{StaticResource ToolbarSeparator}"/>
        
        <!-- Management Tools -->
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
            <Button x:Name="ClearDrawingsButton" 
                    Style="{StaticResource ToolbarButton}"
                    ToolTip="Clear All Drawings"
                    Click="ClearDrawingsButton_Click">
                <Path Data="M 2,2 L 14,14 M 14,2 L 2,14" 
                      Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                      StrokeThickness="2"
                      Stretch="Uniform"
                      Width="16" Height="16"/>
            </Button>
        </StackPanel>
        
        <!-- Status Text -->
        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Right"
                   Text="Select a drawing tool"
                   VerticalAlignment="Center"
                   Margin="16,0"
                   Foreground="{DynamicResource ForegroundBrush}"/>
    </DockPanel>
</UserControl>
