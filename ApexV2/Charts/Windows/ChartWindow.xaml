<Window x:Class="ApexV2.Charts.Windows.ChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:charts="clr-namespace:ApexV2.Charts.Windows"
        mc:Ignorable="d"
        Title="APEX Chart - {Symbol}" 
        Height="600" Width="900"
        MinHeight="400" MinWidth="600"
        Icon="pack://application:,,,/Resources/chart_icon.ico"
        Background="{DynamicResource Brush.WindowBackground}">
    
    <charts:ChartPanel x:Name="MainChartPanel"/>
    
</Window>
