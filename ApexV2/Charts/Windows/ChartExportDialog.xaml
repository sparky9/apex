<Window x:Class="ApexV2.Charts.Windows.ChartExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Chart" Height="450" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Export Chart" 
                      FontSize="18" 
                      FontWeight="Bold" 
                      Foreground="{DynamicResource ForegroundBrush}"/>
            <TextBlock x:Name="SymbolTextBlock" 
                      Text="Symbol: UNKNOWN" 
                      FontSize="12" 
                      Foreground="{DynamicResource SecondaryForegroundBrush}"
                      Margin="0,5,0,0"/>
        </StackPanel>
        
        <!-- Image Export Settings -->
        <GroupBox Grid.Row="1" Header="Image Export Settings" Margin="0,0,0,15"
                  Foreground="{DynamicResource ForegroundBrush}">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                
                <!-- Dimensions -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Dimensions:" 
                          VerticalAlignment="Center" 
                          Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBox x:Name="WidthTextBox" Grid.Row="0" Grid.Column="1" 
                        Text="1920" 
                        VerticalAlignment="Center"
                        Margin="5,0"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="x" 
                          VerticalAlignment="Center" 
                          HorizontalAlignment="Center"
                          Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBox x:Name="HeightTextBox" Grid.Row="0" Grid.Column="4" 
                        Text="1080" 
                        VerticalAlignment="Center"
                        Margin="5,0"/>
                
                <!-- Quality -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="JPEG Quality:" 
                          VerticalAlignment="Center" 
                          Margin="0,10,0,0"
                          Foreground="{DynamicResource ForegroundBrush}"/>
                <Slider x:Name="QualitySlider" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4"
                       Minimum="10" Maximum="100" Value="90" 
                       TickFrequency="10" TickPlacement="BottomRight"
                       Margin="5,10,0,0"
                       ValueChanged="QualitySlider_ValueChanged"/>
                <Label x:Name="QualityLabel" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4"
                      Content="Quality: 90%" 
                      Foreground="{DynamicResource SecondaryForegroundBrush}"
                      Margin="5,0,0,0"/>
            </Grid>
        </GroupBox>
        
        <!-- Export Actions -->
        <GroupBox Grid.Row="2" Header="Export Actions" Margin="0,0,0,15"
                  Foreground="{DynamicResource ForegroundBrush}">
            <StackPanel Margin="10">
                <Button x:Name="ExportImageButton" 
                       Content="Export as Image..." 
                       Height="35" 
                       Margin="0,0,0,10"
                       Click="ExportImageButton_Click"
                       Background="{DynamicResource ButtonBackground}"
                       Foreground="{DynamicResource ForegroundBrush}"
                       BorderBrush="{DynamicResource BorderBrush}"/>
                
                <Button x:Name="ExportDataButton" 
                       Content="Export Data..." 
                       Height="35" 
                       Margin="0,0,0,10"
                       Click="ExportDataButton_Click"
                       Background="{DynamicResource ButtonBackground}"
                       Foreground="{DynamicResource ForegroundBrush}"
                       BorderBrush="{DynamicResource BorderBrush}"/>
                
                <Button x:Name="CopyToClipboardButton" 
                       Content="Copy to Clipboard" 
                       Height="35"
                       Click="CopyToClipboardButton_Click"
                       Background="{DynamicResource AccentBrush}"
                       Foreground="{DynamicResource Brush.TextPrimary}"
                       BorderBrush="{DynamicResource AccentBrush}"/>
            </StackPanel>
        </GroupBox>
        
        <!-- Export Formats Info -->
        <GroupBox Grid.Row="3" Header="Supported Formats" Margin="0,0,0,15"
                  Foreground="{DynamicResource ForegroundBrush}">
            <StackPanel Margin="10">
                <TextBlock Text="Images: PNG, JPEG, BMP, GIF, TIFF" 
                          Foreground="{DynamicResource SecondaryForegroundBrush}"
                          Margin="0,0,0,5"/>
                <TextBlock Text="Data: CSV, JSON, Excel (CSV), Summary (TXT)" 
                          Foreground="{DynamicResource SecondaryForegroundBrush}"/>
            </StackPanel>
        </GroupBox>
        
        <!-- Status -->
        <TextBlock x:Name="StatusTextBlock" Grid.Row="5" 
                  Text="Ready to export" 
                  Foreground="{DynamicResource AccentBrush}"
                  FontWeight="Bold"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Visibility="Visible"/>
        
        <!-- Close Button -->
        <Button x:Name="CloseButton" Grid.Row="6" 
               Content="Close" 
               Width="80" 
               Height="30" 
               HorizontalAlignment="Right"
               Click="CloseButton_Click"
               Background="{DynamicResource ButtonBackground}"
               Foreground="{DynamicResource ForegroundBrush}"
               BorderBrush="{DynamicResource BorderBrush}"/>
    </Grid>
</Window>
