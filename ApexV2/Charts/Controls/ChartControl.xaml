<UserControl x:Class="ApexV2.Charts.Controls.ChartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="800"
             Background="{DynamicResource Brush.PanelBackground}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Chart Header -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.WindowBackground}" 
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock x:Name="SymbolText" Text="AAPL" FontWeight="Bold" FontSize="16" 
                               Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,12,0"/>
                    <TextBlock x:Name="PriceText" Text="$150.25" FontSize="14" 
                               Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="ChangeText" Text="+1.25 (+0.84%)" FontSize="12" 
                               Foreground="#26a69a" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TimeFrameText" Text="1D" FontSize="12" 
                               Foreground="{DynamicResource Brush.TextSecondary}"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="LineChartButton" Content="📈" ToolTip="Line Chart" 
                            Width="24" Height="24" Margin="2,0" Click="LineChartButton_Click"/>
                    <Button x:Name="CandlestickButton" Content="📊" ToolTip="Candlestick Chart" 
                            Width="24" Height="24" Margin="2,0" Click="CandlestickButton_Click"/>
                    <Button x:Name="SettingsButton" Content="⚙️" ToolTip="Chart Settings" 
                            Width="24" Height="24" Margin="2,0" Click="SettingsButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Chart Area -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.WindowBackground}">
            <Grid>
                <!-- Chart Canvas -->
                <Canvas x:Name="ChartCanvas" Background="Transparent" 
                        MouseMove="ChartCanvas_MouseMove"
                        MouseLeave="ChartCanvas_MouseLeave"
                        MouseWheel="ChartCanvas_MouseWheel"
                        MouseLeftButtonDown="ChartCanvas_MouseLeftButtonDown"
                        MouseLeftButtonUp="ChartCanvas_MouseLeftButtonUp"/>
                
                <!-- Crosshair Lines -->
                <Line x:Name="CrosshairVertical" Stroke="#888888" StrokeThickness="1" 
                      Visibility="Collapsed" IsHitTestVisible="False"/>
                <Line x:Name="CrosshairHorizontal" Stroke="#888888" StrokeThickness="1" 
                      Visibility="Collapsed" IsHitTestVisible="False"/>
                
                <!-- Price/Time Labels -->
                <Border x:Name="PriceLabel" Background="Black" CornerRadius="3" Padding="4,2" 
                        Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="PriceLabelText" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="10"/>
                </Border>
                
                <Border x:Name="TimeLabel" Background="Black" CornerRadius="3" Padding="4,2" 
                        Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="TimeLabelText" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="10"/>
                </Border>
                
                <!-- Loading Indicator -->
                <Grid x:Name="LoadingPanel" Background="Transparent" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="100" Height="4" IsIndeterminate="True" Margin="0,0,0,8"/>
                        <TextBlock Text="Loading chart data..." Foreground="{DynamicResource Brush.TextSecondary}" 
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                
                <!-- Error Panel -->
                <Grid x:Name="ErrorPanel" Background="Transparent" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="ErrorText" Text="Failed to load chart data" 
                                   Foreground="#ef5350" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <Button x:Name="RetryButton" Content="Retry" Padding="12,4" Click="RetryButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        
        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.WindowBackground}" 
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="StatusText" Grid.Column="0" Text="Ready" 
                           Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="DataPointsText" Text="0 points" 
                               Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" Margin="0,0,12,0"/>
                    <TextBlock x:Name="LastUpdateText" Text="Never" 
                               Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
