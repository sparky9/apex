<UserControl x:Class="ApexV2.Charts.Controls.ChartPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ApexV2.Charts.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header with real-time controls -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Symbol display -->
                <TextBlock Grid.Column="0" 
                          Text="{Binding CurrentSymbol, FallbackValue='No Symbol'}"
                          FontWeight="Bold"
                          FontSize="14"
                          Foreground="White"
                          VerticalAlignment="Center"
                          Margin="0,0,15,0"/>
                
                <!-- Real-time toggle -->
                <CheckBox Grid.Column="2"
                         Content="Real-time"
                         IsChecked="{Binding IsRealTimeEnabled}"
                         Foreground="White"
                         VerticalAlignment="Center"
                         Margin="0,0,15,0"/>
                
                <!-- Connection status -->
                <Ellipse Grid.Column="3"
                        Width="10" Height="10"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0">
                    <Ellipse.Fill>
                        <SolidColorBrush Color="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}, FallbackValue=Red}"/>
                    </Ellipse.Fill>
                </Ellipse>
                
                <TextBlock Grid.Column="4"
                          Text="{Binding ConnectionStatus}"
                          FontSize="12"
                          Foreground="{Binding IsConnected, Converter={StaticResource BoolToForegroundConverter}, FallbackValue=Red}"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>
        
        <!-- Main chart area -->
        <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1">
            <Grid>
                <!-- Chart content placeholder -->
                <TextBlock Text="Chart visualization goes here"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Foreground="#666666"
                          FontSize="16"/>
                
                <!-- Real-time overlay -->
                <Border Background="Transparent" 
                       Visibility="{Binding IsRealTimeEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                    <!-- Real-time indicators, animations, etc. -->
                </Border>
            </Grid>
        </Border>
        
        <!-- Status bar -->
        <Border Grid.Row="2" Background="#007ACC" Padding="10,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0"
                          Text="Updates:"
                          Foreground="White"
                          FontSize="11"
                          VerticalAlignment="Center"
                          Margin="0,0,5,0"/>
                
                <TextBlock Grid.Column="1"
                          Text="{Binding UpdateCount, FallbackValue=0}"
                          Foreground="White"
                          FontSize="11"
                          FontWeight="Bold"
                          VerticalAlignment="Center"
                          Margin="0,0,15,0"/>
                
                <TextBlock Grid.Column="2"
                          Text="Last Update:"
                          Foreground="White"
                          FontSize="11"
                          VerticalAlignment="Center"
                          Margin="0,0,5,0"/>
                
                <TextBlock Grid.Column="3"
                          Text="{Binding LastUpdate, StringFormat='{}{0:HH:mm:ss.fff}', FallbackValue='Never'}"
                          Foreground="White"
                          FontSize="11"
                          FontWeight="Bold"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
    
    <UserControl.Resources>
        <!-- Value converters for UI binding -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
        <!-- Custom converter for connection status color -->
        <local:BoolToColorConverter x:Key="BoolToColorConverter" 
                                   TrueColor="LimeGreen" 
                                   FalseColor="Red"/>
        
        <!-- Custom converter for connection status foreground -->
        <local:BoolToForegroundConverter x:Key="BoolToForegroundConverter" 
                                        TrueBrush="LimeGreen" 
                                        FalseBrush="Red"/>
    </UserControl.Resources>
</UserControl>
