<Window x:Class="ApexV2.Backtesting.UI.StrategyLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Strategy Library"
        Height="650" Width="900"
        MinHeight="500" MinWidth="700"
        Background="{DynamicResource Brush.WindowBackground}"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Strategy Library" FontSize="20" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    <Border Background="#007ACC" CornerRadius="3" Margin="15,0,0,0" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock x:Name="StrategyCountText" Text="0 Strategies" FontSize="11" Foreground="White"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="RefreshButton" Content="Refresh" Background="#1C97EA" Foreground="White"
                            BorderThickness="0" Padding="15,8" FontSize="12" Click="RefreshButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filters -->
        <Border Grid.Row="1" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Search:" FontSize="12" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                <TextBox Grid.Column="2" x:Name="SearchTextBox" Background="#3C3C3C" Foreground="White"
                         BorderBrush="#555555" BorderThickness="1" Padding="8,6" FontSize="12"
                         TextChanged="SearchTextBox_TextChanged"/>

                <TextBlock Grid.Column="4" Text="Type:" FontSize="12" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="6" x:Name="TypeFilterComboBox" Background="#3C3C3C" Foreground="White"
                          BorderBrush="#555555" BorderThickness="1" Padding="8,6" FontSize="12"
                          SelectionChanged="TypeFilterComboBox_SelectionChanged">
                    <ComboBoxItem Content="All Types" IsSelected="True"/>
                    <ComboBoxItem Content="Trend Following"/>
                    <ComboBoxItem Content="Mean Reversion"/>
                    <ComboBoxItem Content="Momentum"/>
                    <ComboBoxItem Content="Breakout"/>
                    <ComboBoxItem Content="Custom"/>
                </ComboBox>

                <Button Grid.Column="8" Content="Clear Filters" Background="#3C3C3C" Foreground="White"
                        BorderThickness="0" Padding="12,6" FontSize="11" Click="ClearFiltersButton_Click"/>
            </Grid>
        </Border>

        <!-- Strategy List -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="StrategiesPanel" Margin="20">
                <!-- Strategies will be loaded here -->
            </StackPanel>
        </ScrollViewer>

        <!-- Empty State -->
        <StackPanel x:Name="EmptyState" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="📂" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="No Strategies Found" FontSize="18" Foreground="#666666" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="Generate some strategies to get started" FontSize="14" Foreground="#555555" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Action Buttons -->
        <Border Grid.Row="3" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,1,0,0" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Grid.Column="0" Text="Ready" FontSize="12" Foreground="#CCCCCC" VerticalAlignment="Center"/>

                <Button Grid.Column="1" Content="Cancel" Background="#3C3C3C" Foreground="White"
                        BorderThickness="0" Padding="20,10" FontSize="13" Click="CancelButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
