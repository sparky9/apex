<Window x:Class="ApexV2.Backtesting.UI.BacktestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="APEX Backtesting Engine"
        Height="800" Width="1400"
        MinHeight="600" MinWidth="1000"
        Background="{DynamicResource Brush.WindowBackground}"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Strategy Backtesting" FontSize="22" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    <Border Background="#007ACC" CornerRadius="3" Margin="15,0,0,0" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock x:Name="ModeText" Text="Single Strategy" FontSize="11" Foreground="White"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="GenerateStrategiesButton" Content="Generate Strategies" Background="#8B4789" Foreground="White"
                            BorderThickness="0" Padding="15,8" Margin="0,0,10,0" Click="GenerateStrategiesButton_Click" FontSize="12"/>
                    <Button x:Name="LoadStrategyButton" Content="Load Strategy" Background="#1C97EA" Foreground="White"
                            BorderThickness="0" Padding="15,8" Margin="0,0,10,0" Click="LoadStrategyButton_Click" FontSize="12"/>
                    <Button x:Name="RunBacktestButton" Content="Run Backtest" Background="#0E639C" Foreground="White"
                            BorderThickness="0" Padding="20,8" FontSize="12" FontWeight="SemiBold" Click="RunBacktestButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Configuration -->
            <Border Grid.Column="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">

                        <!-- Market Data Section -->
                        <TextBlock Text="MARKET DATA" FontSize="13" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,0,0,10"/>

                        <TextBlock Text="Symbol" FontSize="11" Foreground="#999999" Margin="0,0,0,5"/>
                        <TextBox x:Name="SymbolTextBox" Text="AAPL" Background="#3C3C3C" Foreground="White"
                                 BorderBrush="#555555" BorderThickness="1" Padding="8,6" FontSize="12" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Start Date" FontSize="11" Foreground="#999999" Margin="0,0,0,5"/>
                                <DatePicker x:Name="StartDatePicker" Background="#3C3C3C" Foreground="White"
                                           BorderBrush="#555555" BorderThickness="1" Padding="8,6" FontSize="12"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="End Date" FontSize="11" Foreground="#999999" Margin="0,0,0,5"/>
                                <DatePicker x:Name="EndDatePicker" Background="#3C3C3C" Foreground="White"
                                           BorderBrush="#555555" BorderThickness="1" Padding="8,6" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Timeframe" FontSize="11" Foreground="#999999" Margin="0,0,0,5"/>
                        <ComboBox x:Name="TimeframeComboBox" Background="#3C3C3C" Foreground="White"
                                  BorderBrush="#555555" BorderThickness="1" Padding="8,6" FontSize="12" Margin="0,0,0,20"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="1 Day"/>
                            <ComboBoxItem Content="1 Hour"/>
                            <ComboBoxItem Content="5 Minutes"/>
                            <ComboBoxItem Content="1 Minute"/>
                        </ComboBox>

                        <!-- Backtest Parameters Section -->
                        <Separator Background="#3F3F46" Margin="0,10,0,20"/>
                        <TextBlock Text="BACKTEST PARAMETERS" FontSize="13" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,0,0,10"/>

                        <TextBlock Text="Initial Capital ($)" FontSize="11" Foreground="#999999" Margin="0,0,0,5"/>
                        <TextBox x:Name="InitialCapitalTextBox" Text="10000" Background="#3C3C3C" Foreground="White"
                                 BorderBrush="#555555" BorderThickness="1" Padding="8,6" FontSize="12" Margin="0,0,0,15"/>

                        <TextBlock Text="Position Size ($)" FontSize="11" Foreground="#999999" Margin="0,0,0,5"/>
                        <TextBox x:Name="PositionSizeTextBox" Text="1000" Background="#3C3C3C" Foreground="White"
                                 BorderBrush="#555555" BorderThickness="1" Padding="8,6" FontSize="12" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Commission (%)" FontSize="11" Foreground="#999999" Margin="0,0,0,5"/>
                                <TextBox x:Name="CommissionTextBox" Text="0.1" Background="#3C3C3C" Foreground="White"
                                        BorderBrush="#555555" BorderThickness="1" Padding="8,6" FontSize="12"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Slippage (%)" FontSize="11" Foreground="#999999" Margin="0,0,0,5"/>
                                <TextBox x:Name="SlippageTextBox" Text="0.05" Background="#3C3C3C" Foreground="White"
                                        BorderBrush="#555555" BorderThickness="1" Padding="8,6" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="UseStopLossCheckBox" Content="Use Stop Loss" Foreground="White"
                                  FontSize="12" Margin="0,5,0,10" IsChecked="True"/>
                        <CheckBox x:Name="UseTakeProfitCheckBox" Content="Use Take Profit" Foreground="White"
                                  FontSize="12" Margin="0,0,0,20" IsChecked="True"/>

                        <!-- Strategy Section -->
                        <Separator Background="#3F3F46" Margin="0,10,0,20"/>
                        <TextBlock Text="STRATEGY" FontSize="13" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,0,0,10"/>

                        <TextBlock x:Name="StrategyNameText" Text="No strategy selected" FontSize="12" Foreground="#999999"
                                   Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1" Padding="10" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Entry Rules" FontSize="11" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,0,0,5"/>
                                <TextBlock x:Name="EntryRulesText" Text="None" FontSize="10" Foreground="#999999"
                                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                                <TextBlock Text="Exit Rules" FontSize="11" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,0,0,5"/>
                                <TextBlock x:Name="ExitRulesText" Text="None" FontSize="10" Foreground="#999999"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BuildStrategyButton" Content="Build Custom Strategy" Background="#1C97EA"
                                Foreground="White" BorderThickness="0" Padding="12,8" FontSize="12"
                                Click="BuildStrategyButton_Click" HorizontalAlignment="Stretch"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Panel - Results -->
            <Grid Grid.Column="1" Background="#1E1E1E">
                <TabControl x:Name="ResultsTabControl" Background="Transparent" BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="Border" Background="#2D2D30" BorderBrush="#3F3F46"
                                                BorderThickness="0,0,1,0" Padding="20,12">
                                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center"
                                                            HorizontalAlignment="Center" ContentSource="Header"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#007ACC"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#3E3E42"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontSize" Value="12"/>
                        </Style>
                    </TabControl.Resources>

                    <!-- Overview Tab -->
                    <TabItem Header="Overview">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="30,20">

                                <!-- Performance Summary Cards -->
                                <Grid Margin="0,0,0,30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Total Return Card -->
                                    <Border Grid.Column="0" Background="#2D2D30" BorderBrush="#3F3F46"
                                            BorderThickness="1" Padding="20" CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock Text="Total Return" FontSize="12" Foreground="#CCCCCC" Margin="0,0,0,8"/>
                                            <TextBlock x:Name="TotalReturnText" Text="--" FontSize="28" FontWeight="Bold"
                                                       Foreground="#4EC9B0" Margin="0,0,0,5"/>
                                            <TextBlock x:Name="TotalReturnDollarText" Text="$0.00" FontSize="14" Foreground="#999999"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Sharpe Ratio Card -->
                                    <Border Grid.Column="2" Background="#2D2D30" BorderBrush="#3F3F46"
                                            BorderThickness="1" Padding="20" CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock Text="Sharpe Ratio" FontSize="12" Foreground="#CCCCCC" Margin="0,0,0,8"/>
                                            <TextBlock x:Name="SharpeRatioText" Text="--" FontSize="28" FontWeight="Bold"
                                                       Foreground="White" Margin="0,0,0,5"/>
                                            <TextBlock Text="Risk-Adjusted Return" FontSize="14" Foreground="#999999"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Win Rate Card -->
                                    <Border Grid.Column="4" Background="#2D2D30" BorderBrush="#3F3F46"
                                            BorderThickness="1" Padding="20" CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock Text="Win Rate" FontSize="12" Foreground="#CCCCCC" Margin="0,0,0,8"/>
                                            <TextBlock x:Name="WinRateText" Text="--" FontSize="28" FontWeight="Bold"
                                                       Foreground="White" Margin="0,0,0,5"/>
                                            <TextBlock x:Name="WinLossText" Text="0 Wins / 0 Losses" FontSize="14" Foreground="#999999"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Max Drawdown Card -->
                                    <Border Grid.Column="6" Background="#2D2D30" BorderBrush="#3F3F46"
                                            BorderThickness="1" Padding="20" CornerRadius="4">
                                        <StackPanel>
                                            <TextBlock Text="Max Drawdown" FontSize="12" Foreground="#CCCCCC" Margin="0,0,0,8"/>
                                            <TextBlock x:Name="MaxDrawdownText" Text="--" FontSize="28" FontWeight="Bold"
                                                       Foreground="#F14C4C" Margin="0,0,0,5"/>
                                            <TextBlock Text="Worst Peak-to-Trough" FontSize="14" Foreground="#999999"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Equity Curve Placeholder -->
                                <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1"
                                        Padding="20" CornerRadius="4" Margin="0,0,0,20" Height="300">
                                    <Grid>
                                        <TextBlock Text="Equity Curve" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="White" VerticalAlignment="Top"/>
                                        <TextBlock x:Name="EquityCurvePlaceholder" Text="Run a backtest to see equity curve"
                                                   FontSize="14" Foreground="#666666" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <!-- Chart will be added here programmatically -->
                                        <Border x:Name="EquityCurveContainer"/>
                                    </Grid>
                                </Border>

                                <!-- Detailed Metrics Grid -->
                                <TextBlock Text="DETAILED METRICS" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#CCCCCC" Margin="0,0,0,15"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Column -->
                                    <StackPanel Grid.Column="0">
                                        <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1"
                                                Padding="15" Margin="0,0,0,10">
                                            <Grid>
                                                <TextBlock Text="Total Trades" FontSize="12" Foreground="#CCCCCC"/>
                                                <TextBlock x:Name="TotalTradesText" Text="--" FontSize="12"
                                                           Foreground="White" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>

                                        <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1"
                                                Padding="15" Margin="0,0,0,10">
                                            <Grid>
                                                <TextBlock Text="Profit Factor" FontSize="12" Foreground="#CCCCCC"/>
                                                <TextBlock x:Name="ProfitFactorText" Text="--" FontSize="12"
                                                           Foreground="White" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>

                                        <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1"
                                                Padding="15" Margin="0,0,0,10">
                                            <Grid>
                                                <TextBlock Text="Sortino Ratio" FontSize="12" Foreground="#CCCCCC"/>
                                                <TextBlock x:Name="SortinoRatioText" Text="--" FontSize="12"
                                                           Foreground="White" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>

                                        <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1"
                                                Padding="15" Margin="0,0,0,10">
                                            <Grid>
                                                <TextBlock Text="Calmar Ratio" FontSize="12" Foreground="#CCCCCC"/>
                                                <TextBlock x:Name="CalmarRatioText" Text="--" FontSize="12"
                                                           Foreground="White" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>

                                        <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1"
                                                Padding="15" Margin="0,0,0,10">
                                            <Grid>
                                                <TextBlock Text="Average Win" FontSize="12" Foreground="#CCCCCC"/>
                                                <TextBlock x:Name="AverageWinText" Text="--" FontSize="12"
                                                           Foreground="#4EC9B0" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- Right Column -->
                                    <StackPanel Grid.Column="2">
                                        <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1"
                                                Padding="15" Margin="0,0,0,10">
                                            <Grid>
                                                <TextBlock Text="Annualized Return" FontSize="12" Foreground="#CCCCCC"/>
                                                <TextBlock x:Name="AnnualizedReturnText" Text="--" FontSize="12"
                                                           Foreground="White" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>

                                        <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1"
                                                Padding="15" Margin="0,0,0,10">
                                            <Grid>
                                                <TextBlock Text="Avg Days in Trade" FontSize="12" Foreground="#CCCCCC"/>
                                                <TextBlock x:Name="AvgDaysInTradeText" Text="--" FontSize="12"
                                                           Foreground="White" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>

                                        <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1"
                                                Padding="15" Margin="0,0,0,10">
                                            <Grid>
                                                <TextBlock Text="Max Consecutive Wins" FontSize="12" Foreground="#CCCCCC"/>
                                                <TextBlock x:Name="MaxConsecutiveWinsText" Text="--" FontSize="12"
                                                           Foreground="White" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>

                                        <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1"
                                                Padding="15" Margin="0,0,0,10">
                                            <Grid>
                                                <TextBlock Text="Max Consecutive Losses" FontSize="12" Foreground="#CCCCCC"/>
                                                <TextBlock x:Name="MaxConsecutiveLossesText" Text="--" FontSize="12"
                                                           Foreground="White" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>

                                        <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1"
                                                Padding="15" Margin="0,0,0,10">
                                            <Grid>
                                                <TextBlock Text="Average Loss" FontSize="12" Foreground="#CCCCCC"/>
                                                <TextBlock x:Name="AverageLossText" Text="--" FontSize="12"
                                                           Foreground="#F14C4C" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Trades Tab -->
                    <TabItem Header="Trades">
                        <Grid Background="#1E1E1E">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Trades Header -->
                            <Border Grid.Row="0" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="20,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="#" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                                    <TextBlock Grid.Column="1" Text="Entry Date" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                                    <TextBlock Grid.Column="2" Text="Exit Date" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                                    <TextBlock Grid.Column="3" Text="Entry Price" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="Exit Price" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="5" Text="Shares" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="6" Text="P&amp;L" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="7" Text="Return %" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="8" Text="Exit Reason" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                                </Grid>
                            </Border>

                            <!-- Trades List -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="TradesItemsControl" Background="Transparent">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="20,10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#2D2D30"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding TradeNumber}" FontSize="12" Foreground="#CCCCCC"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding EntryDate, StringFormat=yyyy-MM-dd}" FontSize="12" Foreground="#CCCCCC"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding ExitDate, StringFormat=yyyy-MM-dd}" FontSize="12" Foreground="#CCCCCC"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding EntryPrice, StringFormat=C2}" FontSize="12" Foreground="White" TextAlignment="Right"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding ExitPrice, StringFormat=C2}" FontSize="12" Foreground="White" TextAlignment="Right"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding Shares, StringFormat=N0}" FontSize="12" Foreground="#CCCCCC" TextAlignment="Right"/>
                                                    <TextBlock Grid.Column="6" Text="{Binding ProfitLoss, StringFormat=C2}" FontSize="12" TextAlignment="Right">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsProfit}" Value="True">
                                                                        <Setter Property="Foreground" Value="#4EC9B0"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsProfit}" Value="False">
                                                                        <Setter Property="Foreground" Value="#F14C4C"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="7" Text="{Binding ReturnPct, StringFormat=P2}" FontSize="12" TextAlignment="Right">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsProfit}" Value="True">
                                                                        <Setter Property="Foreground" Value="#4EC9B0"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsProfit}" Value="False">
                                                                        <Setter Property="Foreground" Value="#F14C4C"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="8" Text="{Binding ExitReason}" FontSize="12" Foreground="#999999"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Empty State -->
                            <StackPanel x:Name="TradesEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1">
                                <TextBlock Text="No Trades Yet" FontSize="18" Foreground="#666666"
                                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="Run a backtest to see trade details" FontSize="14"
                                           Foreground="#555555" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- Analysis Tab -->
                    <TabItem Header="Analysis">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="30,20">
                                <TextBlock Text="TRADE DISTRIBUTION" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#CCCCCC" Margin="0,0,0,15"/>

                                <!-- Drawdown Chart Placeholder -->
                                <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1"
                                        Padding="20" CornerRadius="4" Margin="0,0,0,20" Height="250">
                                    <Grid>
                                        <TextBlock Text="Drawdown Chart" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="White" VerticalAlignment="Top"/>
                                        <TextBlock Text="Run a backtest to see drawdown analysis"
                                                   FontSize="14" Foreground="#666666" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Returns Distribution Placeholder -->
                                <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1"
                                        Padding="20" CornerRadius="4" Height="250">
                                    <Grid>
                                        <TextBlock Text="Returns Distribution" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="White" VerticalAlignment="Top"/>
                                        <TextBlock Text="Run a backtest to see returns distribution"
                                                   FontSize="14" Foreground="#666666" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#007ACC" Height="30" Padding="15,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock x:Name="StatusText" Text="Ready" FontSize="12" Foreground="White"
                               VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <ProgressBar x:Name="ProgressBar" Width="200" Height="4" Visibility="Collapsed"
                                 VerticalAlignment="Center" Foreground="White" Background="#0E639C"/>
                </StackPanel>

                <TextBlock x:Name="TimeElapsedText" Grid.Column="2" Text="" FontSize="12"
                           Foreground="White" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
