<Window x:Class="ApexV2.Backtesting.UI.StrategyBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Strategy Builder"
        Height="700" Width="900"
        MinHeight="600" MinWidth="800"
        Background="{DynamicResource Brush.WindowBackground}"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="20,15">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Build Custom Strategy" FontSize="20" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    <Border Background="#8B4789" CornerRadius="3" Margin="15,0,0,0" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="Visual Editor" FontSize="11" Foreground="White"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,20">

                <!-- Strategy Name -->
                <TextBlock Text="STRATEGY NAME" FontSize="13" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,0,0,10"/>
                <TextBox x:Name="StrategyNameTextBox" Text="My Custom Strategy" Background="#3C3C3C" Foreground="White"
                         BorderBrush="#555555" BorderThickness="1" Padding="10,8" FontSize="13" Margin="0,0,0,30"/>

                <!-- Entry Rules Section -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="ENTRY RULES" FontSize="13" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                    <Button Grid.Column="2" x:Name="AddEntryRuleButton" Content="+ Add Rule" Background="#0E639C"
                            Foreground="White" BorderThickness="0" Padding="12,6" FontSize="11"
                            Click="AddEntryRuleButton_Click"/>
                </Grid>

                <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1" Padding="15" Margin="0,0,0,30">
                    <StackPanel x:Name="EntryRulesPanel">
                        <TextBlock Text="Click 'Add Rule' to define entry conditions" FontSize="12"
                                   Foreground="#666666" HorizontalAlignment="Center" Padding="20"/>
                    </StackPanel>
                </Border>

                <!-- Exit Rules Section -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="EXIT RULES" FontSize="13" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                    <Button Grid.Column="2" x:Name="AddExitRuleButton" Content="+ Add Rule" Background="#0E639C"
                            Foreground="White" BorderThickness="0" Padding="12,6" FontSize="11"
                            Click="AddExitRuleButton_Click"/>
                </Grid>

                <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1" Padding="15" Margin="0,0,0,20">
                    <StackPanel x:Name="ExitRulesPanel">
                        <TextBlock Text="Click 'Add Rule' to define exit conditions" FontSize="12"
                                   Foreground="#666666" HorizontalAlignment="Center" Padding="20"/>
                    </StackPanel>
                </Border>

                <!-- Strategy Type -->
                <TextBlock Text="STRATEGY TYPE" FontSize="13" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,10,0,10"/>
                <ComboBox x:Name="StrategyTypeComboBox" Background="#3C3C3C" Foreground="White"
                          BorderBrush="#555555" BorderThickness="1" Padding="10,8" FontSize="12" SelectedIndex="0">
                    <ComboBoxItem Content="Trend Following"/>
                    <ComboBoxItem Content="Mean Reversion"/>
                    <ComboBoxItem Content="Momentum"/>
                    <ComboBoxItem Content="Breakout"/>
                    <ComboBoxItem Content="Swing Trading"/>
                    <ComboBoxItem Content="Custom"/>
                </ComboBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Border Grid.Row="2" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,1,0,0" Padding="30,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ValidationText" Text="" FontSize="12" Foreground="#F14C4C" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Cancel" Background="#3C3C3C" Foreground="White"
                        BorderThickness="0" Padding="20,10" FontSize="13" Click="CancelButton_Click"/>
                <Button Grid.Column="3" x:Name="SaveButton" Content="Save Strategy" Background="#0E639C"
                        Foreground="White" BorderThickness="0" Padding="25,10" FontSize="13" FontWeight="SemiBold"
                        Click="SaveButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
