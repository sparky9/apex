<Window x:Class="ApexV2.Backtesting.UI.RealTimeMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Real-Time Strategy Monitor"
        Height="700" Width="1200"
        MinHeight="600" MinWidth="1000"
        Background="{DynamicResource Brush.WindowBackground}"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Real-Time Monitor" FontSize="20" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    <Border x:Name="StatusIndicator" Background="#4EC9B0" CornerRadius="3" Margin="15,0,0,0" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="Ready" FontSize="11" Foreground="White"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="StartButton" Content="Start Monitoring" Background="#0E639C" Foreground="White"
                            BorderThickness="0" Padding="20,8" Margin="0,0,10,0" FontSize="12" FontWeight="SemiBold" Click="StartButton_Click"/>
                    <Button x:Name="StopButton" Content="Stop" Background="#F14C4C" Foreground="White"
                            BorderThickness="0" Padding="20,8" FontSize="12" Click="StopButton_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Configuration Panel -->
        <Border Grid.Row="1" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Symbol:" FontSize="12" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                <TextBox Grid.Column="2" x:Name="SymbolTextBox" Text="AAPL" Background="#3C3C3C" Foreground="White"
                         BorderBrush="#555555" BorderThickness="1" Padding="8,6" FontSize="12"/>

                <TextBlock Grid.Column="4" Text="Strategy:" FontSize="12" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="6" x:Name="StrategyNameText" Text="No strategy selected" Background="#3C3C3C"
                           Foreground="#999999" Padding="8,6" FontSize="12" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="8" Text="Capital:" FontSize="12" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                <TextBox Grid.Column="10" x:Name="InitialCapitalTextBox" Text="10000" Background="#3C3C3C" Foreground="White"
                         BorderBrush="#555555" BorderThickness="1" Padding="8,6" FontSize="12"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Activity Feed -->
            <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#2D2D30" Padding="15,10" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
                        <TextBlock Text="ACTIVITY FEED" FontSize="13" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" x:Name="ActivityScrollViewer">
                        <StackPanel x:Name="ActivityPanel" Margin="15">
                            <TextBlock Text="No activity yet. Start monitoring to see signals and trades."
                                      FontSize="13" Foreground="#666666" TextAlignment="Center" Margin="0,50,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right Panel - Performance Summary -->
            <Border Grid.Column="1" Background="#252526">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">

                        <!-- Portfolio Summary -->
                        <TextBlock Text="PORTFOLIO" FontSize="13" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,0,0,15"/>

                        <Border Background="#2D2D30" CornerRadius="4" Padding="15" Margin="0,0,0,15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Total Equity" FontSize="12" Foreground="#999999"/>
                                    <TextBlock Grid.Column="1" x:Name="TotalEquityText" Text="$10,000.00" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Cash" FontSize="11" Foreground="#999999"/>
                                    <TextBlock Grid.Column="1" x:Name="CashText" Text="$10,000.00" FontSize="12" Foreground="#CCCCCC"/>
                                </Grid>

                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Total P&amp;L" FontSize="11" Foreground="#999999"/>
                                    <TextBlock Grid.Column="1" x:Name="TotalPnLText" Text="$0.00" FontSize="12" Foreground="#4EC9B0"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Performance Metrics -->
                        <TextBlock Text="PERFORMANCE" FontSize="13" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,10,0,15"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Total Return" FontSize="11" Foreground="#999999"/>
                            <TextBlock Grid.Column="1" x:Name="TotalReturnText" Text="0.00%" FontSize="11" Foreground="#CCCCCC"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Realized P&amp;L" FontSize="11" Foreground="#999999"/>
                            <TextBlock Grid.Column="1" x:Name="RealizedPnLText" Text="$0.00" FontSize="11" Foreground="#CCCCCC"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Unrealized P&amp;L" FontSize="11" Foreground="#999999"/>
                            <TextBlock Grid.Column="1" x:Name="UnrealizedPnLText" Text="$0.00" FontSize="11" Foreground="#CCCCCC"/>
                        </Grid>

                        <Separator Background="#3F3F46" Margin="0,15"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Completed Trades" FontSize="11" Foreground="#999999"/>
                            <TextBlock Grid.Column="1" x:Name="CompletedTradesText" Text="0" FontSize="11" Foreground="#CCCCCC"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Win Rate" FontSize="11" Foreground="#999999"/>
                            <TextBlock Grid.Column="1" x:Name="WinRateText" Text="0.0%" FontSize="11" Foreground="#CCCCCC"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Active Positions" FontSize="11" Foreground="#999999"/>
                            <TextBlock Grid.Column="1" x:Name="ActivePositionsText" Text="0" FontSize="11" Foreground="#CCCCCC"/>
                        </Grid>

                        <!-- Active Positions -->
                        <TextBlock Text="ACTIVE POSITIONS" FontSize="13" FontWeight="SemiBold" Foreground="#CCCCCC" Margin="0,20,0,15"/>

                        <StackPanel x:Name="PositionsPanel">
                            <TextBlock Text="No active positions" FontSize="11" Foreground="#666666" TextAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="FooterStatusText" Grid.Column="0" Text="Ready to start monitoring" FontSize="12" Foreground="#CCCCCC" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Data Feed: " FontSize="11" Foreground="#666666" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DataFeedText" Text="Mock" FontSize="11" Foreground="#4EC9B0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
