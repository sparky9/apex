<Window x:Class="ApexV2.Extensions.API.ApiManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="API Manager - APEX v2" 
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#FF2D2D30">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF3F3F46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF464647"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="80"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF007ACC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FF3F3F46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#FF464647"/>
            <Setter Property="BorderBrush" Value="#FF464647"/>
            <Setter Property="RowBackground" Value="#FF3F3F46"/>
            <Setter Property="AlternatingRowBackground" Value="#FF2D2D30"/>
        </Style>
        
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#FF3F3F46"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF464647"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="🔌" FontSize="24" Margin="0,0,10,0"/>
            <TextBlock Text="API Manager" FontSize="20" FontWeight="Bold"/>
        </StackPanel>

        <!-- Status Panel -->
        <Border Grid.Row="1" Background="#FF3F3F46" BorderBrush="#FF464647" BorderThickness="1" 
                Padding="15" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Status" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="StatusTextBlock" Text="Loading..." FontSize="14"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Version" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="VersionTextBlock" Text="Loading..." FontSize="14"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Services" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="ServicesCountTextBlock" Text="Loading..." FontSize="14"/>
                </StackPanel>
                
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="RefreshButton" Content="🔄 Refresh" Click="RefreshButton_Click"/>
                    <Button x:Name="HealthCheckButton" Content="🏥 Health Check" Click="HealthCheckButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="2" Background="#FF2D2D30" BorderBrush="#FF464647">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="#FF3F3F46"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="#FF464647"/>
                    <Setter Property="Padding" Value="15,8"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#FF007ACC"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- API Keys Tab -->
            <TabItem Header="🔑 API Keys">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- API Keys Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="API Keys Management" FontSize="16" FontWeight="Bold"/>
                        <Button x:Name="CreateApiKeyButton" Content="➕ Create New" 
                                Click="CreateApiKeyButton_Click" Margin="20,0,0,0"/>
                    </StackPanel>

                    <!-- API Keys Grid -->
                    <DataGrid Grid.Row="1" x:Name="ApiKeysDataGrid" 
                              AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="200"/>
                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd}" Width="100"/>
                            <DataGridTextColumn Header="Expires" Binding="{Binding ExpiresAt, StringFormat=yyyy-MM-dd}" Width="100"/>
                            <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60"/>
                            <DataGridTextColumn Header="Key Preview" Width="120">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Key"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- API Keys Actions -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="TestApiButton" Content="🧪 Test Selected" Click="TestApiButton_Click"/>
                        <Button x:Name="RevokeApiKeyButton" Content="🚫 Revoke Selected" Click="RevokeApiKeyButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Services Tab -->
            <TabItem Header="🛠️ Services">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Available API Services" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                    
                    <ListBox Grid.Row="1" x:Name="ServicesListBox">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="5">
                                    <TextBlock Text="🔧" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding}" FontWeight="Bold"/>
                                    <TextBlock Text=" - Active" Foreground="LightGreen" Margin="10,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- Documentation Tab -->
            <TabItem Header="📚 Documentation">
                <ScrollViewer Margin="10">
                    <StackPanel>
                        <TextBlock Text="API Documentation" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                        
                        <TextBlock Text="Base URL:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock Text="https://localhost:5001/api/v1" Foreground="LightBlue" Margin="0,0,0,15"/>
                        
                        <TextBlock Text="Authentication:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock Text="Include your API key in the header: 'X-API-Key: your_api_key_here'" 
                                   TextWrapping="Wrap" Margin="0,0,0,15"/>
                        
                        <TextBlock Text="Available Endpoints:" FontWeight="Bold" Margin="0,0,0,10"/>
                        
                        <StackPanel Margin="20,0,0,0">
                            <TextBlock Text="Market Data:" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="• GET /marketdata/{symbol} - Get market data for a symbol" Margin="0,0,0,2"/>
                            <TextBlock Text="• GET /marketdata/symbols - Get available symbols" Margin="0,0,0,2"/>
                            <TextBlock Text="• GET /marketdata/quote/{symbol} - Get latest quote" Margin="0,0,0,15"/>
                            
                            <TextBlock Text="Watchlists:" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="• GET /watchlists - Get all watchlists" Margin="0,0,0,2"/>
                            <TextBlock Text="• POST /watchlists - Create new watchlist" Margin="0,0,0,2"/>
                            <TextBlock Text="• GET /watchlists/{id} - Get specific watchlist" Margin="0,0,0,2"/>
                            <TextBlock Text="• PUT /watchlists/{id} - Update watchlist" Margin="0,0,0,2"/>
                            <TextBlock Text="• DELETE /watchlists/{id} - Delete watchlist" Margin="0,0,0,15"/>
                            
                            <TextBlock Text="Rate Limits:" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="• 100 requests per minute per API key" Margin="0,0,0,2"/>
                            <TextBlock Text="• 5,000 requests per hour per API key" Margin="0,0,0,2"/>
                            <TextBlock Text="• 50,000 requests per day per API key" Margin="0,0,0,15"/>
                        </StackPanel>
                        
                        <TextBlock Text="Last Updated:" FontWeight="Bold" Margin="0,15,0,5"/>
                        <TextBlock x:Name="TimestampTextBlock" Text="Loading..." Foreground="LightGray"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CloseButton" Content="Close" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>


