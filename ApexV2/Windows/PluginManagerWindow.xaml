<Window x:Class="ApexV2.Windows.PluginManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plugin Manager"
        Width="800"
        Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#FF2B2B2B" Padding="10">
            <StackPanel>
                <TextBlock Text="Plugin Manager" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Manage and configure APEX plugins" FontSize="12" Foreground="#FFCCCCCC"/>
            </StackPanel>
        </Border>
        
        <!-- Plugin List -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <DataGrid x:Name="PluginsDataGrid" 
                      Grid.Column="0"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      SelectionChanged="PluginsDataGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding IsEnabled}" Width="60"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="80" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
            
            <!-- Plugin Control Buttons -->
            <StackPanel Grid.Column="1" Margin="10,0,0,0" Width="120">
                <Button x:Name="StartPluginButton" Content="Start" Click="StartPluginButton_Click" Margin="0,0,0,5" IsEnabled="False"/>
                <Button x:Name="StopPluginButton" Content="Stop" Click="StopPluginButton_Click" Margin="0,0,0,5" IsEnabled="False"/>
                <Button x:Name="ReloadPluginButton" Content="Reload" Click="ReloadPluginButton_Click" Margin="0,0,0,5" IsEnabled="False"/>
                <Button x:Name="UnloadPluginButton" Content="Unload" Click="UnloadPluginButton_Click" Margin="0,0,0,5" IsEnabled="False"/>
                <Separator Margin="0,10"/>
                <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshButton_Click" Margin="0,0,0,5"/>
                <Button x:Name="LoadPluginButton" Content="Load Plugin..." Click="LoadPluginButton_Click" Margin="0,0,0,5"/>
                <Button x:Name="InstallPluginButton" Content="Install..." Click="InstallPluginButton_Click" Margin="0,0,0,5"/>
            </StackPanel>
        </Grid>
        
        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="#FFCCCCCC"/>
        
        <!-- Plugin Details -->
        <TabControl Grid.Row="3" Margin="10">
            <TabItem Header="Details">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" FontWeight="Bold" Margin="0,0,10,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DetailNameText" Margin="0,0,0,5"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Version:" FontWeight="Bold" Margin="0,0,10,5"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DetailVersionText" Margin="0,0,0,5"/>
                        
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Author:" FontWeight="Bold" Margin="0,0,10,5"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DetailAuthorText" Margin="0,0,0,5"/>
                        
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Category:" FontWeight="Bold" Margin="0,0,10,5"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DetailCategoryText" Margin="0,0,0,5"/>
                        
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="State:" FontWeight="Bold" Margin="0,0,10,5"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DetailStateText" Margin="0,0,0,5"/>
                        
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Assembly:" FontWeight="Bold" Margin="0,0,10,5"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="DetailAssemblyText" Margin="0,0,0,5" TextWrapping="Wrap"/>
                        
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Permissions:" FontWeight="Bold" Margin="0,0,10,5"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" x:Name="DetailPermissionsText" Margin="0,0,0,5" TextWrapping="Wrap"/>
                        
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Description:" FontWeight="Bold" Margin="0,0,10,5" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="7" Grid.Column="1" x:Name="DetailDescriptionText" Margin="0,0,0,5" TextWrapping="Wrap"/>
                        
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Tags:" FontWeight="Bold" Margin="0,0,10,5" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="8" Grid.Column="1" x:Name="DetailTagsText" Margin="0,0,0,5" TextWrapping="Wrap"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            
            <TabItem Header="Configuration">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <DataGrid x:Name="ConfigurationDataGrid" 
                              Grid.Row="0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="True"
                              CanUserDeleteRows="True"
                              GridLinesVisibility="All"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Setting" Binding="{Binding Key}" Width="200"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="SaveConfigButton" Content="Save Configuration" Click="SaveConfigButton_Click" Margin="0,0,10,0" IsEnabled="False"/>
                        <Button x:Name="ResetConfigButton" Content="Reset to Defaults" Click="ResetConfigButton_Click" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            
            <TabItem Header="Log">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <ListBox x:Name="LogListBox" Grid.Row="0" FontFamily="Consolas" FontSize="10" 
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                        <Button x:Name="ClearLogButton" Content="Clear Log" Click="ClearLogButton_Click" Margin="0,0,10,0"/>
                        <Button x:Name="ExportLogButton" Content="Export Log..." Click="ExportLogButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
        
        <!-- Footer -->
        <Border Grid.Row="4" Background="#FFF0F0F0" BorderBrush="#FFCCCCCC" BorderThickness="0,1,0,0" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center"/>
                    <Separator Margin="10,0"/>
                    <TextBlock x:Name="PluginCountText" Text="0 plugins loaded" VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Settings..." Click="SettingsButton_Click" Margin="0,0,10,0" Padding="15,5"/>
                    <Button Content="Close" Click="CloseButton_Click" Padding="15,5" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
