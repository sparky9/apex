<UserControl x:Class="ApexV2.Dashboard.Portfolio.PortfolioPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ApexV2.Dashboard.Portfolio"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Unloaded="UserControl_Unloaded">
    
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Portfolio" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    <Border Background="#007ACC" CornerRadius="3" Margin="10,0,0,0" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock x:Name="BrokerNameText" Text="Not Connected" FontSize="10" Foreground="White"/>
                    </Border>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ConnectButton" Content="Connect" Background="#0E639C" Foreground="White" 
                            BorderThickness="0" Padding="12,6" Margin="0,0,5,0" Click="ConnectButton_Click"/>
                    <Button x:Name="RefreshButton" Content="Refresh" Background="#1C97EA" Foreground="White" 
                            BorderThickness="0" Padding="12,6" Margin="5,0,0,0" Click="RefreshButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Portfolio Summary -->
        <Border Grid.Row="1" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Total Value" FontSize="10" Foreground="#CCCCCC"/>
                    <TextBlock x:Name="TotalValueText" Text="$0.00" FontSize="16" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Day Change" FontSize="10" Foreground="#CCCCCC"/>
                    <TextBlock x:Name="DayChangeText" Text="$0.00 (0.00%)" FontSize="16" FontWeight="Bold" Foreground="#4EC9B0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Total Gain/Loss" FontSize="10" Foreground="#CCCCCC"/>
                    <TextBlock x:Name="TotalGainLossText" Text="$0.00 (0.00%)" FontSize="16" FontWeight="Bold" Foreground="#4EC9B0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Cash Balance" FontSize="10" Foreground="#CCCCCC"/>
                    <TextBlock x:Name="CashBalanceText" Text="$0.00" FontSize="16" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
                
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Buying Power" FontSize="10" Foreground="#CCCCCC"/>
                    <TextBlock x:Name="BuyingPowerText" Text="$0.00" FontSize="16" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Positions Table -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Table Header -->
            <Border Grid.Row="0" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="15,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="Symbol" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                    <TextBlock Grid.Column="1" Text="Company" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                    <TextBlock Grid.Column="2" Text="Quantity" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC" TextAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="Avg Cost" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC" TextAlignment="Right"/>
                    <TextBlock Grid.Column="4" Text="Current Price" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC" TextAlignment="Right"/>
                    <TextBlock Grid.Column="5" Text="Market Value" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC" TextAlignment="Right"/>
                    <TextBlock Grid.Column="6" Text="Unrealized P&amp;L" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC" TextAlignment="Right"/>
                    <TextBlock Grid.Column="7" Text="Day Change" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC" TextAlignment="Right"/>
                    <TextBlock Grid.Column="8" Text="Sector" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                </Grid>
            </Border>
            
            <!-- Positions List -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PositionsItemsControl" Background="Transparent">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="15,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2D2D30"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Grid.Column="0" Text="{Binding Symbol}" FontSize="12" Foreground="White" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CompanyName}" FontSize="12" Foreground="#CCCCCC" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Quantity, StringFormat=N0}" FontSize="12" Foreground="#CCCCCC" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="{Binding AverageCost, StringFormat=C2}" FontSize="12" Foreground="#CCCCCC" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="{Binding CurrentPrice, StringFormat=C2}" FontSize="12" Foreground="#CCCCCC" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="5" Text="{Binding MarketValue, StringFormat=C2}" FontSize="12" Foreground="White" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="6" Text="{Binding UnrealizedGainLoss, StringFormat=C2}" FontSize="12" TextAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UnrealizedGainLoss, Converter={StaticResource GreaterThanZeroConverter}}" Value="True">
                                                        <Setter Property="Foreground" Value="#4EC9B0"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding UnrealizedGainLoss, Converter={StaticResource LessThanZeroConverter}}" Value="True">
                                                        <Setter Property="Foreground" Value="#F14C4C"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding UnrealizedGainLoss, Converter={StaticResource EqualToZeroConverter}}" Value="True">
                                                        <Setter Property="Foreground" Value="#CCCCCC"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="7" Text="{Binding DayChange, StringFormat=C2}" FontSize="12" TextAlignment="Right">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DayChange, Converter={StaticResource GreaterThanZeroConverter}}" Value="True">
                                                        <Setter Property="Foreground" Value="#4EC9B0"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DayChange, Converter={StaticResource LessThanZeroConverter}}" Value="True">
                                                        <Setter Property="Foreground" Value="#F14C4C"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DayChange, Converter={StaticResource EqualToZeroConverter}}" Value="True">
                                                        <Setter Property="Foreground" Value="#CCCCCC"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="8" Text="{Binding Sector}" FontSize="12" Foreground="#CCCCCC" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        
        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#007ACC" VerticalAlignment="Bottom" Height="25" Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="StatusText" Grid.Column="0" Text="Ready" FontSize="11" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock x:Name="LastUpdateText" Grid.Column="2" Text="" FontSize="11" Foreground="White" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
    
    <UserControl.Resources>
        <!-- Value Converters -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Custom converters would need to be implemented in code-behind -->
        <local:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter"/>
        <local:LessThanZeroConverter x:Key="LessThanZeroConverter"/>
        <local:EqualToZeroConverter x:Key="EqualToZeroConverter"/>
    </UserControl.Resources>
</UserControl>
